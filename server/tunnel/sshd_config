# Reverse tunnels only: no shell, no file transfer, no outgoing forwards.
Port 2222
HostKey /data/ssh_host_ed25519_key
AuthorizedKeysFile /etc/ssh/authorized_keys/%u
AllowUsers tunnel
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
MaxAuthTries 3
LoginGraceTime 20
MaxStartups 10:30:30

AllowTcpForwarding remote
# The boards ask for 127.0.0.1:<port>; "yes" binds it on the container's own address instead, which is what the
# published port (host 127.0.0.1 only, see compose.yaml) reaches. PermitListen is the list of board ports.
GatewayPorts yes
PermitListen 22041 22042
AllowAgentForwarding no
AllowStreamLocalForwarding no
PermitTunnel no
X11Forwarding no
PermitTTY no
PermitUserRC no
ForceCommand /bin/false

# A tunnel whose board vanished (modem reboot) is dropped after 3 minutes, so the board can open its port again.
ClientAliveInterval 60
ClientAliveCountMax 3
TCPKeepAlive yes
PrintMotd no
LogLevel VERBOSE
