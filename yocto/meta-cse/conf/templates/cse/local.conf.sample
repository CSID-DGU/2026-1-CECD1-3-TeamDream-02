# Generated once from meta-cse/conf/templates/cse; real settings live in conf/distro/cse.conf.
MACHINE ?= "raspberrypi0-wifi"
DISTRO ?= "cse"

# Shared across build dirs (yocto/downloads, yocto/sstate-cache)
DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"

# Free-space guard for long builds
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K"

CONF_VERSION = "2"
