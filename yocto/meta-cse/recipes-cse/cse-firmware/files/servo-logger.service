[Unit]
Description=CSE servo board: indicator-light logger and button presser
After=local-fs.target

[Service]
Type=simple
User=cse
# '+' runs as root. PWM outlives the process, so: signals off before start and after any exit.
# "setup" also exports the two channels and lets user cse drive them (a press comes from `servo-press`).
ExecStartPre=+/usr/libexec/cse-servo-pwm setup
# current -> slots/a|b, switched by the OTA updater (cse-ota.service)
ExecStart=/var/lib/cse-ota/current/servo log
ExecStopPost=+/usr/libexec/cse-servo-pwm off
StateDirectory=cse-servo
Restart=always
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SyslogIdentifier=cse-servo

[Install]
WantedBy=multi-user.target
