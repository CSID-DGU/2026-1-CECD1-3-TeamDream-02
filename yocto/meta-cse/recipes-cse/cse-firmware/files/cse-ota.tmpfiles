# A/B app slots for /usr/bin/ota (CSE_ROOT=/var/lib/cse-ota). Created on first boot only: after that the updater owns them.
# Slot a starts with the binary shipped in the image; @BOARD@ and @SEED@ are filled in by the recipe.
d /var/lib/cse-ota 0755 cse cse -
d /var/lib/cse-ota/slots 0755 cse cse -
d /var/lib/cse-ota/slots/a 0755 cse cse -
d /var/lib/cse-ota/slots/b 0755 cse cse -
C /var/lib/cse-ota/slots/a/@BOARD@ - - - - /usr/lib/cse/@BOARD@
f /var/lib/cse-ota/slots/a/build.json 0644 cse cse - @SEED@
L /var/lib/cse-ota/current - - - - slots/a
L /var/lib/cse-ota/ota.conf - - - - /etc/cse/ota.conf
